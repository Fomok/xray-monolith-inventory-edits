-- Isolated lab fixture. Inert unless launched with -sqa3-fixture.
local started, stage, failed = nil, 1, false
local commands = {}
local crate_id,loot_id
local changing,condition_tick=false,0
local npc_id,corpse_loot_id
local capacity_rifle,capacity_pack
local sale_item,sale_actor_money,sale_partner_money
local function capacity_spawn_rifle()
    local a=db.actor;local item=alife():create("wpn_ak74",a:position(),a:level_vertex_id(),a:game_vertex_id(),a:id())
    assert(item,"capacity rifle spawn failed");capacity_rifle=item.id
end
local function capacity_ruck_rifle()
    local item=level.object_by_id(capacity_rifle);assert(item,"capacity rifle not online")
    db.actor:move_to_ruck(item)
end
local function capacity_spawn_pack()
    local a=db.actor;local item=alife():create("itm_backpack",a:position(),a:level_vertex_id(),a:game_vertex_id(),a:id())
    assert(item,"capacity backpack spawn failed");capacity_pack=item.id
end
local function capacity_equip_pack()
    local item=level.object_by_id(capacity_pack);assert(item,"capacity backpack not online")
    if not db.actor:item_in_slot(13) then assert(ActorMenu.get_actor_menu():ToSlot(item,true,13),"capacity backpack equip failed") end
    assert(db.actor:item_in_slot(13) and db.actor:item_in_slot(13):id()==capacity_pack,"wrong backpack equipped")
end
local function capacity_ruck_pack()
    local item=db.actor:item_in_slot(13);assert(item and item:id()==capacity_pack,"capacity backpack missing")
    db.actor:move_to_ruck(item)
end
local function spawn_npc()
    local a=db.actor;local pos=a:position();pos.x=pos.x+1.2
    local npc=alife():create("sim_default_stalker_1",pos,a:level_vertex_id(),a:game_vertex_id())
    assert(npc,"fixture NPC spawn failed");npc_id=npc.id
end
local function open_trade()
    local npc=level.object_by_id(npc_id);assert(npc and npc:alive(),"fixture NPC not online")
    npc:start_trade(db.actor)
    assert(ActorMenu.get_actor_menu():IsShown() and ActorMenu.get_menu_mode()==2,"native trade menu did not open")
    printf("[SQA3 AUTORUN] native trade menu opened NPC=%s",tostring(npc_id))
end
local function prepare_sale()
    local npc=level.object_by_id(npc_id);assert(npc and npc:alive(),"sale NPC missing")
    -- This disposable simulation NPC otherwise walks outside native trade range.
    npc:movement_enabled(false)
    local pos=db.actor:position();pos.x=pos.x+1.2
    npc:set_npc_position(pos)
    npc:give_money(100000)
    db.actor:iterate_inventory(function(_,item)
        if item:section()=="bread" then sale_item=item:id() end
        return false
    end,db.actor)
    assert(sale_item,"sale fixture needs bread")
end
local function hold_sale()
    local npc=level.object_by_id(npc_id);assert(npc,"sale NPC missing")
    local distance=npc:position():distance_to(db.actor:position())
    printf("[SQA3 AUTORUN] sale readiness distance=%s menu=%s",tostring(distance),tostring(ActorMenu.get_actor_menu():IsShown()))
    assert(distance<3 and ActorMenu.get_actor_menu():IsShown(),"sale menu closed before input window")
    sale_actor_money=db.actor:money();sale_partner_money=npc:money()
    started=started+60000
    printf("[SQA3 AUTORUN] sale input window live=%s actor_money=%s partner_money=%s",tostring(sale_item),tostring(sale_actor_money),tostring(sale_partner_money))
end
local function check_sale()
    local npc=level.object_by_id(npc_id);assert(npc,"sale NPC missing")
    local actor_has,partner_has=false,false
    db.actor:iterate_inventory(function(_,item) if item:id()==sale_item then actor_has=true end return false end,db.actor)
    npc:iterate_inventory(function(_,item) if item:id()==sale_item then partner_has=true end return false end,npc)
    assert(not actor_has and partner_has,"sale did not transfer exact bread identity")
    local gained=db.actor:money()-sale_actor_money
    assert(gained>0 and sale_partner_money-npc:money()==gained,"sale money not conserved")
    printf("[SQA3 AUTORUN] native sale verified live=%s actor_gain=%s partner_loss=%s",tostring(sale_item),tostring(gained),tostring(sale_partner_money-npc:money()))
    ActorMenu.get_actor_menu():HideDialog()
end
local function prepare_buyback()
    npc_id=tonumber(command_line():match("%-sqa3%-fixture%-buyback=(%d+)"))
    local npc=npc_id and level.object_by_id(npc_id)
    assert(npc and npc:alive() and npc:section()=="sim_default_stalker_1","saved sale NPC unavailable")
    npc:movement_enabled(false)
    local pos=db.actor:position();pos.x=pos.x+1.2;npc:set_npc_position(pos)
    local breads=0
    npc:iterate_inventory(function(_,item)
        if item:section()=="bread" then sale_item=item:id();breads=breads+1 end
        return false
    end,npc)
    assert(breads==1,"buyback needs exactly the saved sale bread")
    db.actor:give_money(100000)
end
local function check_buyback()
    local npc=level.object_by_id(npc_id);assert(npc,"buyback NPC missing")
    local actor_has,partner_has=false,false
    db.actor:iterate_inventory(function(_,item) if item:id()==sale_item then actor_has=true end return false end,db.actor)
    npc:iterate_inventory(function(_,item) if item:id()==sale_item then partner_has=true end return false end,npc)
    assert(actor_has and not partner_has,"buyback did not return exact bread identity")
    local spent=sale_actor_money-db.actor:money()
    assert(spent>0 and npc:money()-sale_partner_money==spent,"buyback money not conserved")
    printf("[SQA3 AUTORUN] native buyback verified live=%s actor_loss=%s partner_gain=%s",tostring(sale_item),tostring(spent),tostring(npc:money()-sale_partner_money))
    ActorMenu.get_actor_menu():HideDialog()
end
local function kill_npc()
    ActorMenu.get_actor_menu():HideDialog()
    local npc=level.object_by_id(npc_id);assert(npc and npc:alive(),"fixture NPC missing before kill")
    npc:kill(npc)
end
local function fill_corpse()
    local npc=level.object_by_id(npc_id);assert(npc and not npc:alive(),"fixture NPC did not die")
    local a=db.actor;local item=alife():create("bread",a:position(),a:level_vertex_id(),a:game_vertex_id(),npc_id)
    assert(item,"corpse bread spawn failed");corpse_loot_id=item.id
end
local function open_corpse()
    local npc=level.object_by_id(npc_id);assert(npc and not npc:alive(),"corpse not online")
    assert(npc:use(db.actor),"corpse use rejected")
    assert(ActorMenu.get_actor_menu():IsShown() and ActorMenu.get_menu_mode()==4,"native corpse menu did not open")
end
local function check_corpse_loot()
    local found=false
    db.actor:iterate_inventory(function(_,item) if item:id()==corpse_loot_id then found=true end return false end,db.actor)
    assert(found,"corpse bread identity missing from actor")
    printf("[SQA3 AUTORUN] native corpse loot verified live=%s",tostring(corpse_loot_id))
end
local function spawn_crate()
    local a=db.actor;local pos=a:position();pos.x=pos.x+0.8
    local box=alife():create("inventory_box",pos,a:level_vertex_id(),a:game_vertex_id())
    assert(box,"native crate spawn failed");crate_id=box.id
end
local function fill_crate()
    local a=db.actor;local item=alife():create("bread",a:position(),a:level_vertex_id(),a:game_vertex_id(),crate_id)
    assert(item,"native crate item spawn failed");loot_id=item.id
end
local function open_crate()
    local box=level.object_by_id(crate_id);assert(box,"crate not online")
    assert(box:use(db.actor),"native crate use rejected")
    assert(ActorMenu.get_actor_menu():IsShown() and ActorMenu.get_menu_mode()==4,"normal loot menu not opened")
    printf("[SQA3 AUTORUN] native loot menu opened crate=%s",tostring(crate_id))
end
local function take_all()
    local key=bind_to_dik(key_bindings.kSPRINT_TOGGLE,-1);assert(key and key>0)
    level.press_action(key);level.release_action(key)
end
local function check_loot()
    local box=level.object_by_id(crate_id);assert(box and box:is_inv_box_empty(),"crate did not empty")
    local found=false
    db.actor:iterate_inventory(function(_,item) if item:id()==loot_id then found=true end return false end,db.actor)
    assert(found,"native loot identity missing from actor")
    printf("[SQA3 AUTORUN] native loot transfer verified live=%s",tostring(loot_id))
end
local function toggle_inventory()
    local key=bind_to_dik(key_bindings.kINVENTORY,-1)
    assert(key and key>0,"inventory key missing")
    level.press_action(key);level.release_action(key)
    printf("[SQA3 AUTORUN] normal inventory key=%s shown=%s",tostring(key),tostring(ActorMenu.get_actor_menu():IsShown()))
end
local function unequip_fixture()
    local weapon=db.actor:item_in_slot(2)
    assert(weapon and weapon:section()=="wpn_pm","spawned pistol not equipped")
    db.actor:move_to_ruck(weapon)
end
local function equip_fixture()
    assert(not db.actor:item_in_slot(2),"native unequip did not clear slot2")
    local weapon
    db.actor:iterate_inventory(function(_,item) if item:section()=="wpn_pm" then weapon=item end return false end,db.actor)
    assert(weapon,"missing native pistol")
    assert(ActorMenu.get_actor_menu():ToSlot(weapon,true,2),"native menu equip rejected")
end
local function check_equipment()
    local weapon=db.actor:item_in_slot(2)
    assert(weapon and weapon:section()=="wpn_pm","native pistol slot mismatch")
    printf("[SQA3 AUTORUN] equipment slot2 verified live=%s",tostring(weapon:id()))
end
local function filter_consumables()
    level.press_action(DIK_keys.DIK_7);level.release_action(DIK_keys.DIK_7)
    local button=ActorMenu.get_actor_menu():FindChild("button_sort_tab_7")
    assert(button and not button:IsEnabled(),"consumables filter did not activate")
    printf("[SQA3 AUTORUN] consumables filter active; PDA remains model-occupied at4,3")
end
local function filter_all()
    level.press_action(DIK_keys.DIK_1);level.release_action(DIK_keys.DIK_1)
    local button=ActorMenu.get_actor_menu():FindChild("button_sort_tab_1")
    assert(button and not button:IsEnabled(),"all-items filter did not restore")
end
local function check_consumed()
    local count,grams,has_bread=0,0,false
    db.actor:iterate_inventory(function(_,item)
        if item:section()=="bread" then has_bread=true end
        count=count+1;grams=grams+item:weight()*1000;return false
    end,db.actor)
    -- Assert outside the engine's Lua callback boundary so pcall can report failure.
    assert(not has_bread,"bread was not consumed through item action")
    assert(count==4 and math.abs(grams-1448)<0.01,"unexpected consumption count or mass")
    printf("[SQA3 AUTORUN] native consumption verified count4 grams1448")
    if not ActorMenu.get_actor_menu():IsShown() then toggle_inventory() end
end
local function consume_native()
    local bread
    db.actor:iterate_inventory(function(_,item) if item:section()=="bread" then bread=item end return false end,db.actor)
    assert(bread,"native consumption fixture needs bread")
    db.actor:eat(bread)
    printf("[SQA3 AUTORUN] scripted native inventory Eat dispatched; not a mouse-action test")
end
local function snapshot()
    local count, grams = 0, 0
    db.actor:iterate_inventory(function(_, item)
        count=count+1;grams=grams+item:weight()*1000
        printf("[SQA3 AUTORUN] item id=%s section=%s grams=%s condition=%s",tostring(item:id()),item:section(),tostring(item:weight()*1000),tostring(item:condition()))
        return false
    end,db.actor)
    printf("[SQA3 AUTORUN] native count=%s grams=%s",tostring(count),tostring(grams))
end
local function spawn()
    local a=db.actor
    local sections={"bandage","medkit"}
    if command_line():find("-sqa3-fixture-equipment",1,true) then sections[#sections+1]="wpn_pm" end
    for _,section in ipairs(sections) do
        assert(system_ini():section_exist(section),"missing fixture section "..section)
        local item=alife():create(section,a:position(),a:level_vertex_id(),a:game_vertex_id(),a:id())
        assert(item,"fixture spawn failed "..section)
    end
end
function update()
    if failed or not db or not db.actor then return end
    if changing then
        condition_tick=condition_tick+1
        db.actor:iterate_inventory(function(_,item)
            if item:section()=="bandage" then item:set_condition(0.6+(condition_tick%100)/1000) end
            return false
        end,db.actor)
    end
    -- Actor updates can begin before the native precache input gate has cleared.
    if not started then started=time_global()+10000;printf("[SQA3 AUTORUN] actor ready; waiting for startup input gate") end
    if time_global()-started < stage*2000 then return end
    local command=commands[stage]
    if not command then return end
    stage=stage+1
    printf("[SQA3 AUTORUN] step=%s execute %s",tostring(stage-1),type(command)=="string" and command or "native fixture")
    local ok,err
    if type(command)=="string" then ok,err=pcall(exec_console_cmd,command) else ok,err=pcall(command) end
    if not ok then
        failed=true;printf("[SQA3 AUTORUN] FAIL %s",tostring(err));exec_console_cmd("quit")
    end
end
function on_game_start()
    local args=command_line()
    if not args:find("-sqa3-fixture",1,true) then return end
    if args:find("-sqa3-fixture-owned-box",1,true) then
        local sources={}
        commands={"inventory_next_probe export",snapshot,spawn_crate}
        commands[#commands+1]=function()
            local a=db.actor
            for i=1,67 do
                local item=alife():create("bandage",a:position(),a:level_vertex_id(),a:game_vertex_id(),crate_id)
                assert(item,"owned source spawn failed");sources[#sources+1]=item.id
            end
        end
        commands[#commands+1]=open_crate
        commands[#commands+1]=take_all
        commands[#commands+1]=function()
            local accepted,refused=0,0
            for _,id in ipairs(sources) do
                local item=level.object_by_id(id);assert(item and item:parent(),"owned transfer detached or lost item")
                if item:parent():id()==db.actor:id() then accepted=accepted+1
                else assert(item:parent():id()==crate_id,"owned refusal changed source");refused=refused+1
                    printf("[SQA3 AUTORUN] refused owned source live=%s owner=%s",tostring(id),tostring(crate_id)) end
            end
            printf("[SQA3 AUTORUN] box admission accepted=%s source_retained=%s box=%s",tostring(accepted),tostring(refused),tostring(crate_id))
            assert(accepted==65 and refused==2,"owned last-cell competition failed")
        end
        commands[#commands+1]=take_all
        commands[#commands+1]=function()
            local refused=0
            for _,id in ipairs(sources) do local item=level.object_by_id(id);assert(item and item:parent(),"owned retry detached item");if item:parent():id()==crate_id then refused=refused+1 end end
            assert(refused==2,"owned full-grid retry accepted surplus")
            printf("[SQA3 AUTORUN] repeated full-grid refusal retained two exact box sources")
        end
        commands[#commands+1]="screenshot sqa3_owned_box"
        commands[#commands+1]=snapshot
        commands[#commands+1]="inventory_next_probe export"
        commands[#commands+1]="save sqa3_owned_box"
        commands[#commands+1]="quit"
        RegisterScriptCallback("actor_on_update",update)
        return
    end
    if args:find("-sqa3-fixture-ground-disappear",1,true) then
        local gone
        commands={"inventory_next_probe export",snapshot}
        commands[#commands+1]=function()
            local a=db.actor;local pos=a:position();pos.x=pos.x+2
            local item=alife():create("bandage",pos,a:level_vertex_id(),a:game_vertex_id())
            assert(item,"disappearing source spawn failed");gone=item.id
        end
        commands[#commands+1]=function()
            local item=level.object_by_id(gone);local server=alife():object(gone)
            assert(item and server and not item:parent(),"disappearing source not online")
            alife():release(server,true)
            db.actor:take_item(item) -- queued after destruction while client reference still exists
            printf("[SQA3 AUTORUN] queued ground source destruction before pickup live=%s",tostring(gone))
        end
        commands[#commands+1]=function()
            assert(not level.object_by_id(gone) and not alife():object(gone),"destroyed source remained live")
            printf("[SQA3 AUTORUN] disappearing ground source removed without acquisition")
        end
        commands[#commands+1]=snapshot
        commands[#commands+1]="inventory_next_probe export"
        commands[#commands+1]="save sqa3_ground_disappear"
        commands[#commands+1]="quit"
        RegisterScriptCallback("actor_on_update",update)
        return
    end
    if args:find("-sqa3-fixture-ground",1,true) then
        local sources={}
        commands={"inventory_next_probe export",snapshot}
        if args:find("-sqa3-fixture-ground-reload",1,true) then
            commands[#commands+1]=function()
                local expected=args:match("%-sqa3%-fixture%-ground%-sources=([%d,]+)")
                if not expected then return end
                local count=0
                for value in expected:gmatch("%d+") do
                    local id=tonumber(value);local item=level.object_by_id(id)
                    assert(item and not item:parent() and item:section()=="bandage","refused source lost or acquired across reload")
                    assert(math.abs(item:weight()*1000-38)<0.01 and item:condition()==1,"refused source state changed")
                    printf("[SQA3 AUTORUN] reloaded refused source live=%s grams=38 condition=1",value);count=count+1
                end
                assert(count==2,"reload needs two refused source identities")
            end
        end
        if not args:find("-sqa3-fixture-ground-reload",1,true) then
            commands[#commands+1]=function()
                local a=db.actor;local pos=a:position();pos.x=pos.x+2
                for i=1,67 do
                    local item=alife():create("bandage",pos,a:level_vertex_id(),a:game_vertex_id())
                    assert(item,"ground fixture spawn failed");sources[#sources+1]=item.id
                end
            end
            commands[#commands+1]=function()
                for _,id in ipairs(sources) do
                    local item=level.object_by_id(id);assert(item and not item:parent(),"ground source missing before request")
                    db.actor:take_item(item)
                end
            end
            commands[#commands+1]=function()
                local accepted,refused=0,0
                for _,id in ipairs(sources) do
                    local item=level.object_by_id(id);assert(item,"pickup lost real source identity")
                    if item:parent() and item:parent():id()==db.actor:id() then accepted=accepted+1
                    else assert(not item:parent(),"refused source changed owner");refused=refused+1 end
                end
                printf("[SQA3 AUTORUN] ground admission accepted=%s source_retained=%s",tostring(accepted),tostring(refused))
                assert(accepted==65 and refused==2,"last-slot competition or capacity admission failed")
                -- Repeat the refused requests after client acknowledgements.
                for _,id in ipairs(sources) do local item=level.object_by_id(id);if not item:parent() then db.actor:take_item(item) end end
            end
            commands[#commands+1]=function()
                local refused=0
                for _,id in ipairs(sources) do local item=level.object_by_id(id);assert(item,"repeat refusal destroyed source");if not item:parent() then refused=refused+1 end end
                assert(refused==2,"full grid repeat pickup accepted surplus")
                printf("[SQA3 AUTORUN] repeated full-grid refusal retained two exact ground sources")
            end
        end
        commands[#commands+1]=function() if not ActorMenu.get_actor_menu():IsShown() then toggle_inventory() end end
        commands[#commands+1]="screenshot sqa3_ground_admission"
        commands[#commands+1]=snapshot
        commands[#commands+1]="inventory_next_probe export"
        commands[#commands+1]="save sqa3_ground_admission"
        commands[#commands+1]="quit"
        RegisterScriptCallback("actor_on_update",update)
        return
    end
    if args:find("-sqa3-fixture-logical",1,true) then
        commands={"inventory_next_probe export",snapshot,toggle_inventory}
        if not args:find("-sqa3-fixture-logical-reload",1,true) then
            commands[#commands+1]=capacity_spawn_pack
            commands[#commands+1]=capacity_equip_pack
            -- Known disposable sqa3_replacement: identities100..104; new pack105.
            commands[#commands+1]="inventory_next_store 102 105 1 1 0"
            commands[#commands+1]="inventory_next_store 101 1 2 0 0" -- medkit vacated this pocket; bread occupies0,0
            commands[#commands+1]=capacity_ruck_pack
        else
            commands[#commands+1]=function()
                local count=0
                db.actor:iterate_inventory(function(_,item)
                    if item:section()=="itm_backpack" then capacity_pack=item:id();count=count+1 end
                    return false
                end,db.actor)
                assert(count==1,"logical reload needs exactly one backpack")
            end
            if not args:find("-sqa3-fixture-logical-no-equip",1,true) then
                commands[#commands+1]=capacity_equip_pack
            end
        end
        commands[#commands+1]=function()
            local pack=level.object_by_id(capacity_pack);assert(pack,"logical backpack missing")
            db.actor:drop_item(pack) -- server must refuse loaded subtree detach
        end
        commands[#commands+1]=function()
            local pack=level.object_by_id(capacity_pack)
            assert(pack and pack:parent() and pack:parent():id()==db.actor:id(),"loaded backpack was detached")
            printf("[SQA3 AUTORUN] loaded backpack drop refused; native parent retained")
        end
        commands[#commands+1]=function()
            if ActorMenu.get_actor_menu():IsShown() then toggle_inventory() end
        end
        commands[#commands+1]=function()
            if not ActorMenu.get_actor_menu():IsShown() then toggle_inventory() end
            assert(ActorMenu.get_actor_menu():IsShown(),"logical inventory did not reopen")
        end
        if args:find("-sqa3-fixture-hold",1,true) then
            commands[#commands+1]=function() started=started+60000;printf("[SQA3 AUTORUN] logical storage input window") end
        end
        commands[#commands+1]="screenshot sqa3_logical_storage"
        commands[#commands+1]=snapshot
        commands[#commands+1]="inventory_next_probe export"
        local logical_save="sqa3_logical_unequipped"
        if args:find("-sqa3-fixture-logical-reload",1,true) then
            logical_save=args:find("-sqa3-fixture-logical-no-equip",1,true) and "sqa3_logical_carried" or "sqa3_logical_equipped"
        end
        commands[#commands+1]="save "..logical_save
        commands[#commands+1]="quit"
        RegisterScriptCallback("actor_on_update",update)
        return
    end
    commands={"inventory_next_probe export"}
    if args:find("-sqa3-fixture-spawn",1,true) then commands[#commands+1]=spawn end
    commands[#commands+1]=snapshot
    commands[#commands+1]="inventory_next_probe export"
    if args:find("-sqa3-fixture-edit",1,true) then
        commands[#commands+1]="inventory_next_move 100 4 3 0"
        commands[#commands+1]="inventory_next_move 101 4 3 0" -- must reject overlap
        commands[#commands+1]="inventory_next_move 100 -1 3 0" -- must reject bounds
        commands[#commands+1]="inventory_next_probe export"
    end
    if args:find("-sqa3-fixture-use",1,true) then commands[#commands+1]="inventory_next_move 104 3 5 0" end
    commands[#commands+1]=toggle_inventory
    commands[#commands+1]=function() assert(ActorMenu.get_actor_menu():IsShown(),"normal inventory did not open") end
    if args:find("-sqa3-fixture-equipment",1,true) then
        commands[#commands+1]=unequip_fixture
        commands[#commands+1]="inventory_next_move 103 5 6 1" -- rotated bag pistol must enter its native slot correctly
        commands[#commands+1]=toggle_inventory
        commands[#commands+1]=toggle_inventory
        commands[#commands+1]="screenshot sqa3_rotated_pistol"
        commands[#commands+1]=equip_fixture
        commands[#commands+1]=check_equipment
        commands[#commands+1]="inventory_next_probe export"
    end
    if args:find("-sqa3-fixture-consume",1,true) then
        commands[#commands+1]=consume_native
        commands[#commands+1]=check_consumed
    end
    if args:find("-sqa3-fixture-rotate",1,true) then
        commands[#commands+1]=unequip_fixture
        commands[#commands+1]=args:find("-sqa3-fixture-rotate-edge",1,true) and "inventory_next_move 103 7 6 1" or "inventory_next_move 103 5 6 0"
        commands[#commands+1]=toggle_inventory
        commands[#commands+1]=toggle_inventory
        commands[#commands+1]=function() printf("[SQA3 AUTORUN] select the bag pistol, then press the reload binding to rotate") end
    end
    if args:find("-sqa3-fixture-hold",1,true) then
        commands[#commands+1]=function()
            started=started+60000;changing=args:find("-sqa3-fixture-changing",1,true)~=nil
            printf("[SQA3 AUTORUN] holding view for bounded input test; changing=%s",tostring(changing))
        end
        commands[#commands+1]=function() changing=false;printf("[SQA3 AUTORUN] condition update ticks=%s",tostring(condition_tick)) end
    end
    if args:find("-sqa3-fixture-context-use",1,true) then
        commands[#commands+1]=function()
            level.press_action(DIK_keys.MOUSE_2);level.release_action(DIK_keys.MOUSE_2)
            started=started+30000
            printf("[SQA3 AUTORUN] native context click; bounded 30-second action window")
        end
    end
    if args:find("-sqa3-fixture-bound-rotate",1,true) then
        commands[#commands+1]=function()
            -- The computer-use test positions the real cursor over the observed pistol.
            -- Route selection and the configured key through normal engine input;
            -- this is not evidence that OS-level keyboard injection succeeded.
            level.press_action(DIK_keys.MOUSE_1);level.release_action(DIK_keys.MOUSE_1)
            printf("[SQA3 AUTORUN] native mouse selection at current cursor")
        end
        local rotate_binding=function()
            local key=bind_to_dik(key_bindings.kWPN_RELOAD,-1)
            assert(key and key>0,"reload key missing")
            level.press_action(key);level.release_action(key)
            printf("[SQA3 AUTORUN] native reload binding dispatched key=%s",tostring(key))
        end
        commands[#commands+1]=rotate_binding
        if args:find("-sqa3-fixture-rotation-repeat",1,true) then
            commands[#commands+1]=rotate_binding
            commands[#commands+1]=rotate_binding
            commands[#commands+1]=filter_consumables
            commands[#commands+1]=rotate_binding -- hidden selection must be cleared
            commands[#commands+1]=filter_all
        end
    end
    if args:find("-sqa3-fixture-use",1,true) then commands[#commands+1]=check_consumed end
    if args:find("-sqa3-fixture-filter",1,true) then
        commands[#commands+1]=filter_consumables
        commands[#commands+1]="screenshot sqa3_filtered"
        commands[#commands+1]="inventory_next_move 101 4 3 0" -- hidden PDA still reserves these cells
        commands[#commands+1]="inventory_next_probe export"
        commands[#commands+1]=filter_all
    end
    commands[#commands+1]="screenshot sqa3_native"
    commands[#commands+1]="inventory_next_probe export"
    commands[#commands+1]=snapshot
    local save=args:find("-sqa3-fixture-reload",1,true) and "sqa3_replacement_reload" or "sqa3_replacement"
    if args:find("-sqa3-fixture-corpse",1,true) then save="sqa3_corpse" end
    if args:find("-sqa3-fixture-consume",1,true) then save="sqa3_consumed" end
    if args:find("-sqa3-fixture-use",1,true) then save="sqa3_mouse_consumed" end
    if args:find("-sqa3-fixture-rotate",1,true) then save="sqa3_rotation" end
    if args:find("-sqa3-fixture-rotate-edge",1,true) then save="sqa3_rotation_edge" end
    commands[#commands+1]="save "..save
    commands[#commands+1]=toggle_inventory
    commands[#commands+1]=function() assert(not ActorMenu.get_actor_menu():IsShown(),"inventory key did not close") end
    commands[#commands+1]=toggle_inventory
    commands[#commands+1]=function() assert(ActorMenu.get_actor_menu():IsShown(),"inventory key did not reopen") end
    commands[#commands+1]="screenshot sqa3_reopen"
    if args:find("-sqa3-fixture-loot",1,true) then
        commands[#commands+1]=toggle_inventory
        commands[#commands+1]=spawn_crate
        commands[#commands+1]=fill_crate
        commands[#commands+1]=open_crate
        commands[#commands+1]="screenshot sqa3_loot_before"
        commands[#commands+1]=take_all
        commands[#commands+1]=check_loot
        commands[#commands+1]="inventory_next_probe export"
        commands[#commands+1]="screenshot sqa3_loot_after"
        commands[#commands+1]=snapshot
        commands[#commands+1]="save "..save
    end
    if args:find("-sqa3-fixture-corpse",1,true) then
        commands[#commands+1]=function() ActorMenu.get_actor_menu():HideDialog() end
        commands[#commands+1]=spawn_npc
        commands[#commands+1]=open_trade
        commands[#commands+1]="screenshot sqa3_trade"
        commands[#commands+1]=kill_npc
        commands[#commands+1]=fill_corpse
        commands[#commands+1]=open_corpse
        commands[#commands+1]="screenshot sqa3_corpse_before"
        commands[#commands+1]=take_all
        commands[#commands+1]=check_corpse_loot
        commands[#commands+1]="inventory_next_probe export"
        commands[#commands+1]="screenshot sqa3_corpse_after"
        commands[#commands+1]=snapshot
        commands[#commands+1]="save "..save
    end
    if args:find("-sqa3-fixture-capacity",1,true) then
        commands[#commands+1]=capacity_spawn_rifle
        commands[#commands+1]=capacity_ruck_rifle
        commands[#commands+1]="inventory_next_probe capacity"
        commands[#commands+1]=capacity_spawn_pack
        commands[#commands+1]=capacity_equip_pack
        commands[#commands+1]="inventory_next_probe capacity"
        commands[#commands+1]=capacity_ruck_pack
        commands[#commands+1]="inventory_next_probe capacity"
        commands[#commands+1]=snapshot
        commands[#commands+1]="inventory_next_probe export"
        commands[#commands+1]="save sqa3_capacity"
    end
    if args:find("-sqa3-fixture-trade",1,true) then
        commands[#commands+1]=function() ActorMenu.get_actor_menu():HideDialog() end
        commands[#commands+1]=spawn_npc
        commands[#commands+1]=prepare_sale
        commands[#commands+1]=open_trade
        commands[#commands+1]="screenshot sqa3_trade_sale"
        commands[#commands+1]=hold_sale
        commands[#commands+1]=check_sale
        commands[#commands+1]=snapshot
        commands[#commands+1]="inventory_next_probe export"
        commands[#commands+1]="save sqa3_trade_sale"
    end
    if args:find("-sqa3-fixture-buyback=",1,true) then
        commands[#commands+1]=function() ActorMenu.get_actor_menu():HideDialog() end
        commands[#commands+1]=prepare_buyback
        commands[#commands+1]=open_trade
        commands[#commands+1]="screenshot sqa3_trade_buyback"
        commands[#commands+1]=hold_sale
        commands[#commands+1]=check_buyback
        commands[#commands+1]=snapshot
        commands[#commands+1]="inventory_next_probe export"
        commands[#commands+1]="save sqa3_trade_buyback"
    end
    commands[#commands+1]="quit"
    printf("[SQA3 AUTORUN] registered isolated native fixture")
    RegisterScriptCallback("actor_on_update",update)
end
