            local box=level.object_by_id(crate_id)
            assert(box and box:is_inv_box_empty(),"loaded release crate gained an item")
            printf("[SQA3 AUTORUN] loaded release retained bag=%s empty_crate=%s",tostring(bag_id),tostring(crate_id))
        end
