    if args:find("-sqa3-fixture-direct-equip",1,true) then
        local sources,acquired,retained={}
        local function weapons(prefix)
            for _,id in ipairs(sources) do
                local item=level.object_by_id(id);assert(item and item:parent(),"direct equip weapon missing")
                printf("[SQA3 AUTORUN] direct equip %sweapon live=%s parent=%s grams=%s condition=%s ammo=%s",prefix,tostring(id),tostring(item:parent():id()),tostring(item:weight()*1000),tostring(item:condition()),tostring(item:get_ammo_in_magazine()))
            end
        end
        commands={"inventory_next_probe export",snapshot}
        if args:find("-sqa3-fixture-direct-equip-reload",1,true) then
            commands[#commands+1]=function()
                crate_id=tonumber(args:match("%-sqa3%-equip%-source=(%d+)"))
                acquired=tonumber(args:match("%-sqa3%-equip%-item=(%d+)"))
                retained=tonumber(args:match("%-sqa3%-equip%-retained=(%d+)"))
                assert(crate_id and acquired and retained,"direct equip reload IDs missing")
                sources={acquired,retained}
            end
        else
            commands[#commands+1]=spawn_crate
            commands[#commands+1]=function()
                local a=db.actor;assert(not a:item_in_slot(3),"direct equip needs empty primary slot")
                for i=1,2 do
                    local item=alife():create("wpn_ak74",a:position(),a:level_vertex_id(),a:game_vertex_id(),crate_id)
                    assert(item,"direct equip weapon spawn failed");sources[#sources+1]=item.id
                end
            end
            commands[#commands+1]=function()
                for i,id in ipairs(sources) do
                    local item=level.object_by_id(id);assert(item,"direct equip weapon not online")
                    -- Weapon saves use NET_Packet q8 condition (read divisor
                    -- 255.0001). Use representable values for exact reload checks.
                    item:set_condition((i==1 and 212 or 232)/255.0001);item:set_ammo_elapsed(i==1 and 5 or 9)
                end
            end
            commands[#commands+1]=function() weapons("before ") end
            commands[#commands+1]=open_crate
            commands[#commands+1]=function()
                started=started+90000
                printf("[SQA3 AUTORUN] direct equip mouse input window: drag one rifle into empty primary slot; test remaining rifle with occupied-slot drag or Move to slot context action")
            end
        end
        commands[#commands+1]=function()
            local equipped=db.actor:item_in_slot(3);assert(equipped,"direct equip primary slot empty")
            local found=0
            for _,id in ipairs(sources) do
                local item=level.object_by_id(id);assert(item and item:parent(),"direct equip lost source")
                if item:parent():id()==db.actor:id() then
                    found=found+1;assert(equipped:id()==id,"direct equip landed in bag or wrong slot")
                    if acquired then assert(acquired==id,"direct equip identity changed on reload") end
                    acquired=id
                else
                    assert(item:parent():id()==crate_id,"direct equip source owner changed")
                    if retained then assert(retained==id,"retained weapon identity changed") end
                    retained=id
                end
            end
            assert(found==1 and acquired and retained,"direct equip needs one accepted and one retained")
            printf("[SQA3 AUTORUN] direct equip result acquired=%s retained=%s source=%s slot=3",tostring(acquired),tostring(retained),tostring(crate_id))
            weapons("")
        end
        commands[#commands+1]="screenshot sqa3_direct_equip"
        commands[#commands+1]=function() if ActorMenu.get_actor_menu():IsShown() then ActorMenu.get_actor_menu():HideDialog() end end
        commands[#commands+1]=function()
            local active=db.actor:active_item()
            printf("[SQA3 AUTORUN] direct equip active after close live=%s",active and tostring(active:id()) or "none")
        end
        commands[#commands+1]="screenshot sqa3_direct_equip_active"
        commands[#commands+1]=snapshot
        commands[#commands+1]="inventory_next_probe export"
        commands[#commands+1]="save sqa3_direct_equip"
        commands[#commands+1]="quit"
        RegisterScriptCallback("actor_on_update",update)
        return
    end
    if args:find("-sqa3-fixture-purchase-refusal-mouse",1,true) then
        local actor_money,seller_money
        local sources={}
        commands={"inventory_next_probe export",snapshot,function()
            npc_id=tonumber(args:match("%-sqa3%-purchase%-seller=(%d+)"))
            local npc=npc_id and level.object_by_id(npc_id);assert(npc and npc:alive(),"refusal seller missing")
            npc:movement_enabled(false);local pos=db.actor:position();pos.x=pos.x+1.2;npc:set_npc_position(pos)
            local ids=args:match("%-sqa3%-purchase%-sources=([%d,]+)");assert(ids,"refusal sources missing")
            for value in ids:gmatch("%d+") do sources[#sources+1]=tonumber(value) end
            assert(#sources==2,"refusal needs two exact sources")
            actor_money=db.actor:money();seller_money=npc:money()
        end,open_trade,function()
            started=started+60000
            printf("[SQA3 AUTORUN] purchase refusal mouse input window seller=%s actor_money=%s seller_money=%s",tostring(npc_id),tostring(actor_money),tostring(seller_money))
        end,function()
            local npc=level.object_by_id(npc_id);assert(npc and db.actor:money()==actor_money and npc:money()==seller_money,"refused mouse purchase changed money")
            for _,id in ipairs(sources) do
                local item=level.object_by_id(id);assert(item and item:parent() and item:parent():id()==npc_id,"refused mouse purchase moved source")
                assert(item:section()=="bandage" and item:condition()==1 and math.abs(item:weight()*1000-38)<0.01,"refused source state changed")
                printf("[SQA3 AUTORUN] purchase refusal mouse retained live=%s seller=%s",tostring(id),tostring(npc_id))
            end
            printf("[SQA3 AUTORUN] purchase refusal mouse verified actor_money=%s seller_money=%s",tostring(actor_money),tostring(seller_money))
        end,"screenshot sqa3_purchase_refusal_mouse",function() ActorMenu.get_actor_menu():HideDialog() end,snapshot,"inventory_next_probe export","save sqa3_purchase_refusal_mouse","quit"}
        RegisterScriptCallback("actor_on_update",update)
        return
    end
    if args:find("-sqa3-fixture-purchase-mouse",1,true) then
        local source_id,actor_money,seller_money
        commands={"inventory_next_probe export",snapshot}
        if args:find("-sqa3-fixture-purchase-mouse-reload",1,true) then
            commands[#commands+1]=function()
                npc_id=tonumber(args:match("%-sqa3%-purchase%-seller=(%d+)"))
                source_id=tonumber(args:match("%-sqa3%-purchase%-item=(%d+)"))
                local npc=npc_id and level.object_by_id(npc_id)
                local item=source_id and level.object_by_id(source_id)
                assert(npc and npc:alive() and item and item:parent() and item:parent():id()==db.actor:id(),"mouse purchase reload identity mismatch")
                actor_money=tonumber(args:match("%-sqa3%-purchase%-actor%-money=(%d+)"))
                seller_money=tonumber(args:match("%-sqa3%-purchase%-seller%-money=(%d+)"))
                assert(db.actor:money()==actor_money and npc:money()==seller_money,"mouse purchase reload money mismatch")
                printf("[SQA3 AUTORUN] mouse purchase reload live=%s seller=%s actor_money=%s seller_money=%s",tostring(source_id),tostring(npc_id),tostring(actor_money),tostring(seller_money))
            end
        else
            commands[#commands+1]=spawn_npc
            commands[#commands+1]=function()
                local a=db.actor;local npc=level.object_by_id(npc_id);assert(npc and npc:alive(),"mouse purchase seller missing")
                npc:movement_enabled(false);local pos=a:position();pos.x=pos.x+1.2;npc:set_npc_position(pos)
                a:give_money(1000000);npc:give_money(1000000)
                -- Remove only bandages from this newly spawned disposable seller so
                -- its visible bandage cell identifies exactly the new test item.
                local previous={}
                npc:iterate_inventory(function(_,item) if item:section()=="bandage" then previous[#previous+1]=item:id() end return false end,npc)
                for _,id in ipairs(previous) do local item=alife():object(id);if item then alife():release(item,true) end end
                local item=alife():create("bandage",a:position(),a:level_vertex_id(),a:game_vertex_id(),npc_id)
                assert(item,"mouse purchase source spawn failed");source_id=item.id
            end
            commands[#commands+1]=open_trade
            commands[#commands+1]=function()
                actor_money=db.actor:money();seller_money=level.object_by_id(npc_id):money()
                started=started+90000
                printf("[SQA3 AUTORUN] mouse purchase input window live=%s seller=%s actor_money=%s seller_money=%s",tostring(source_id),tostring(npc_id),tostring(actor_money),tostring(seller_money))
            end
            commands[#commands+1]=function()
                local item=level.object_by_id(source_id);local npc=level.object_by_id(npc_id)
                assert(item and item:parent() and item:parent():id()==db.actor:id(),"mouse purchase did not acquire exact source")
                local spent=actor_money-db.actor:money()
                assert(npc and spent>0 and npc:money()-seller_money==spent,"mouse purchase money not conserved")
                printf("[SQA3 AUTORUN] mouse purchase verified live=%s seller=%s spent=%s actor_money=%s seller_money=%s",tostring(source_id),tostring(npc_id),tostring(spent),tostring(db.actor:money()),tostring(npc:money()))
            end
        end
        commands[#commands+1]="screenshot sqa3_purchase_mouse"
        commands[#commands+1]=function()
            -- Vanilla item_device temporarily substitutes device charge while
            -- trade is open; close normally so its callback restores real state.
            if ActorMenu.get_actor_menu():IsShown() then ActorMenu.get_actor_menu():HideDialog() end
        end
        commands[#commands+1]=snapshot
        commands[#commands+1]="inventory_next_probe export"
        commands[#commands+1]="save sqa3_purchase_mouse"
        commands[#commands+1]="quit"
        RegisterScriptCallback("actor_on_update",update)
        return
    end
    if args:find("-sqa3-fixture-purchase",1,true) then
        local sources,actor_money,seller_money={},nil,nil
        commands={"inventory_next_probe export",snapshot}
        if args:find("-sqa3-fixture-purchase-reload",1,true) then
            commands[#commands+1]=function()
                npc_id=tonumber(args:match("%-sqa3%-purchase%-seller=(%d+)"))
                local npc=npc_id and level.object_by_id(npc_id);assert(npc and npc:alive(),"saved purchase seller missing")
                local expected_actor=tonumber(args:match("%-sqa3%-purchase%-actor%-money=(%d+)"))
                local expected_seller=tonumber(args:match("%-sqa3%-purchase%-seller%-money=(%d+)"))
                assert(db.actor:money()==expected_actor and npc:money()==expected_seller,"purchase money changed on reload")
                local ids=args:match("%-sqa3%-purchase%-sources=([%d,]+)");assert(ids,"purchase reload needs retained IDs")
                local count=0
                for value in ids:gmatch("%d+") do
                    local item=level.object_by_id(tonumber(value));assert(item and item:parent() and item:parent():id()==npc_id,"purchase source changed on reload")
                    assert(item:section()=="bandage" and item:condition()==1 and math.abs(item:weight()*1000-38)<0.01,"purchase source state changed")
                    count=count+1;printf("[SQA3 AUTORUN] purchase reloaded retained live=%s seller=%s",value,tostring(npc_id))
                end
                assert(count==2,"purchase reload needs two sources")
                printf("[SQA3 AUTORUN] purchase money reloaded actor=%s seller=%s",tostring(expected_actor),tostring(expected_seller))
            end
        else
            commands[#commands+1]=spawn_npc
            commands[#commands+1]=function()
                local a=db.actor;local npc=level.object_by_id(npc_id);assert(npc and npc:alive(),"purchase seller missing")
                npc:movement_enabled(false);local pos=a:position();pos.x=pos.x+1.2;npc:set_npc_position(pos)
                a:give_money(1000000);npc:give_money(1000000)
                for i=1,67 do
                    local item=alife():create("bandage",a:position(),a:level_vertex_id(),a:game_vertex_id(),npc_id)
                    assert(item,"purchase item spawn failed");sources[#sources+1]=item.id
                end
            end
            commands[#commands+1]=open_trade
            commands[#commands+1]=function()
                actor_money=db.actor:money();seller_money=level.object_by_id(npc_id):money()
                exec_console_cmd("inventory_next_purchase "..npc_id.." "..table.concat(sources," "))
            end
            commands[#commands+1]=function()
                for _,id in ipairs(sources) do local item=level.object_by_id(id);assert(item and item:parent() and item:parent():id()==npc_id,"refused basket partially moved") end
                assert(db.actor:money()==actor_money and level.object_by_id(npc_id):money()==seller_money,"refused basket changed money")
                printf("[SQA3 AUTORUN] purchase whole basket refused count67 actor_money=%s seller_money=%s",tostring(actor_money),tostring(seller_money))
                local chosen={};for i=1,65 do chosen[#chosen+1]=sources[i] end
                exec_console_cmd("inventory_next_purchase "..npc_id.." "..table.concat(chosen," "))
            end
            commands[#commands+1]=function()
                for i,id in ipairs(sources) do
                    local item=level.object_by_id(id);assert(item and item:parent(),"purchase lost or detached item")
                    assert(item:parent():id()==(i<=65 and db.actor:id() or npc_id),"purchase batch ownership mismatch")
                    if i>65 then printf("[SQA3 AUTORUN] purchase retained live=%s seller=%s",tostring(id),tostring(npc_id)) end
                end
                local spent=actor_money-db.actor:money();local gained=level.object_by_id(npc_id):money()-seller_money
                assert(spent>0 and spent==gained,"purchase money not conserved")
                printf("[SQA3 AUTORUN] purchase verified count65 spent=%s actor_money=%s seller_money=%s owner=%s",tostring(spent),tostring(db.actor:money()),tostring(level.object_by_id(npc_id):money()),tostring(npc_id))
                actor_money=db.actor:money();seller_money=level.object_by_id(npc_id):money()
                exec_console_cmd("inventory_next_purchase "..npc_id.." "..sources[66].." "..sources[67])
            end
            commands[#commands+1]=function()
                for i=66,67 do local item=level.object_by_id(sources[i]);assert(item and item:parent() and item:parent():id()==npc_id,"purchase retry detached source") end
                assert(db.actor:money()==actor_money and level.object_by_id(npc_id):money()==seller_money,"full purchase retry changed money")
                printf("[SQA3 AUTORUN] purchase full retry retained sources and money")
            end
        end
        commands[#commands+1]="screenshot sqa3_purchase"
        commands[#commands+1]=function()
            if ActorMenu.get_actor_menu():IsShown() then ActorMenu.get_actor_menu():HideDialog() end
        end
        commands[#commands+1]=snapshot
        commands[#commands+1]="inventory_next_probe export"
        commands[#commands+1]="save sqa3_purchase"
        commands[#commands+1]="quit"
        RegisterScriptCallback("actor_on_update",update)
        return
    end
