            assert(crate_id and moved and retained,"direct unequip IDs missing")
        end,"inventory_next_probe export",snapshot}
        if not args:find("-sqa3-fixture-direct-unequip-reload",1,true) then
            commands[#commands+1]=function()
                assert(db.actor:item_in_slot(3) and db.actor:item_in_slot(3):id()==moved,"direct unequip needs primary rifle")
                weapons("before ")
            end
