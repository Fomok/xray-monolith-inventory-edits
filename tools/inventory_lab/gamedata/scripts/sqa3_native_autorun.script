            commands[#commands+1]=function()
                started=started+60000
                printf("[SQA3 AUTORUN] direct unequip mouse input window: drag primary rifle straight into crate")
            end
        end
        commands[#commands+1]=function()
            assert(not db.actor:item_in_slot(3),"direct unequip primary slot still occupied")
            for _,id in ipairs({moved,retained}) do
                local item=level.object_by_id(id)
