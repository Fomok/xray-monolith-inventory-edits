+    // A D3D11 NGX parameter table carried through Dx11wDx12 can expose the
+    // bridge's D3D12 pointers only through Get(void**). A successful typed Get
+    // may still return null. Keep native D3D12 tables working and fall back to
+    // the same untyped representation the bridge writes before dispatch.
+    auto getResource = [&](const char* name, ID3D12Resource*& resource)
+    {
+        InParameters->Get(name, &resource);
+        if (resource == nullptr)
+        {
+            void* pointer = nullptr;
+            if (InParameters->Get(name, &pointer) == NVSDK_NGX_Result_Success)
+                resource = static_cast<ID3D12Resource*>(pointer);
+        }
+    };
+    getResource(NVSDK_NGX_Parameter_Output, paramOutput);
+    getResource(NVSDK_NGX_Parameter_MotionVectors, paramMotion);
+    getResource(NVSDK_NGX_Parameter_Depth, paramDepth);
 
