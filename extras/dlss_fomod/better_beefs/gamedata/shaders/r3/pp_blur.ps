#include "screenspace_common.h"
#include "check_screenspace.h"
#include "night_vision.h"

float4 blur_params;

//=============================================================================
// HELPERS
//=============================================================================

// Aspect-correct offset: makes blur circular regardless of resolution.
float2 aspect_correct_offset(float2 offset)
{
	return offset * float2(screen_res.y / screen_res.x, 1.0);
}

//=============================================================================
// CIRCULAR BOKEH BLUR - shared by quarter and eighth res passes
//=============================================================================

// Pass 1: thresholded luminance + lightmap extraction with circular blur
float3 circular_blur_thresh(float2 uv, float general_thresh, float light_thresh,
                            float directions, float quality, float radius)
{
	// Bloom channel must be more selective than luma/albedo channel.
	// When light_thresh <= general_thresh, the 8x amplification turns
	// the bloom buffer into an amplified copy of the entire scene.
	light_thresh = max(light_thresh, general_thresh + 0.03);

	float tau = 6.28318530718;
	float angle_step = tau / directions;
	float3 color_average = s_image.Sample(smp_rtlinear, uv).rgb;

	for (float i = 1.0; i <= quality; i++)
	{
		float2 dir = float2(1.0, 0.0);
		float2x2 R = rot(angle_step);

		for (float d = 0.0; d < directions; d += 1.0)
		{
			float2 sample_offset = dir * radius * i / screen_res.xy;
			float3 color = s_image.SampleLevel(smp_rtlinear,
				uv + aspect_correct_offset(sample_offset), 0).rgb;

			// Threshold and gamma-correct luma + albedo
			color.rb *= color.rb;
			color.rb = saturate((color.rb - general_thresh) / (1.0 - general_thresh));
			color.g  = saturate((color.g  - light_thresh)   / (1.0 - light_thresh));

			// Amplify bright lightmap samples — dark samples stay at 0 naturally
			color.g *= 8.0;

			color.rb = sqrt(color.rb);
			color_average += color;
			dir = mul(dir, R);
		}
	}

	float total_samples = directions * quality + 1.0;
	float3 result;
	result.rb = color_average.rb / total_samples;
	result.g  = color_average.g  / total_samples;
	return result;
}

// Pass 2: smooth circular bokeh (no thresholding)
float3 circular_blur_smooth(float2 uv, float directions, float quality, float radius)
{
	float tau = 6.28318530718;
	float angle_step = tau / directions;
	float3 color_average = s_image.Sample(smp_rtlinear, uv).rgb;

	for (float i = 1.0; i <= quality; i++)
	{
		float2 dir = float2(1.0, 0.0);
		float2x2 R = rot(angle_step);

		for (float d = 0.0; d < directions; d += 1.0)
		{
			float2 sample_offset = dir * radius * i / screen_res.xy;
			float3 color = s_image.SampleLevel(smp_rtlinear,
				uv + aspect_correct_offset(sample_offset), 0).rgb;

			// Amplify bright lightmap samples — dark samples stay near 0 naturally
			color.g *= 4.0;

			color_average += color;
			dir = mul(dir, R);
		}
	}

	float total_samples = directions * quality + 1.0;
	float3 result;
	result.rb = color_average.rb / total_samples;
	result.g  = color_average.g  / total_samples;
	return result;
}

//=============================================================================
// MAIN
//=============================================================================

float4 main(p_screen I) : SV_Target
{
	float3 image;
	float lua_param_nvg_generation    = floor(shader_param_8.x);
	float lua_param_nvg_num_tubes     = frac(shader_param_8.x) * 10.0f;
	float lua_param_nvg_washout_thresh = (round(frac(shader_param_8.y) * 10.0) + 1.0) / 20.0; // decode digit 0-9 → 0.05-0.50
	float lua_param_vignette_current  = floor(shader_param_8.z) / 100.0f;

	if (lua_param_nvg_generation > 0.0f
		&& compute_lens_mask(aspect_ratio_correction(I.tc0), lua_param_nvg_num_tubes) == 1.0f)
	{
		// =====================================================================
		// HALF RES BLUR - PASS 1
		// R = Luma, G = Lightmap, B = Normalized depth
		// Blurs everything uniformly — nvg_process controls depth-based application
		// =====================================================================
		if (blur_params.x == 1 && blur_params.z == (screen_res.x / 2.0f))
		{
			// Convert depth UVs using the depth resource dimensions.
			uint depth_width, depth_height;
			s_position.GetDimensions(depth_width, depth_height);
			float2 depth_size = float2(depth_width, depth_height);
			image = float3(
				s_image.Sample(smp_rtlinear, I.tc0).rg,
				saturate(s_position.Load(int3(I.tc0 * depth_size, 0), 0).z / farthest_depth));
			if (image.b == 0.0f) { image.b = 1.0f; }

			float scale = 0.05f;
			scale *= IGN_calc(I.tc0 / 2.0 * screen_res.xy);

			float3 total = 0.0f;
			float divisor = 0.0f;
			float total_depth = image.b;
			float divisor_depth = 1.0f;

			float r = 1.0f;
			float2x2 G = rot(2.399996);
			float2 offset = float2(scale, scale);

			for (int i = 0; i < 16; ++i)
			{
				r += 1.0f / r;
				offset = mul(offset, G);
				float2 sample_uv = I.tc0 + aspect_correct_offset(offset * (r - 1.0f) / screen_res.xy);

				float3 color;
				color.rg = s_image.SampleLevel(smp_rtlinear, sample_uv, 0).rg;
				color.b = saturate(s_position.Load(int3(sample_uv * depth_size, 0), 0).z / farthest_depth);
				if (color.b == 0.0f) { color.b = 1.0f; }

				float weight = 1.0f;
				total.rg += color.rg * weight;
				divisor += weight;

				if (color.b <= image.b - 0.04)
				{
					total_depth += color.b;
					divisor_depth += weight;
				}
			}

			image = float3(max(total.rg / divisor, 0), max(total_depth / divisor_depth, 0));
			float vignette = calc_vignette(lua_param_nvg_num_tubes, I.tc0, lua_param_vignette_current);
			image = clamp(image, 0.0, 1.0) * vignette;
			return float4(image, 1.0f);
		}

		// =====================================================================
		// HALF RES BLUR - PASS 2
		// R = Luma, G = Lightmap, B = Blurred depth
		// Depth-based falloff: near objects get more blur, far objects less
		// =====================================================================
		else if (blur_params.x == 0 && blur_params.z == (screen_res.x / 2.0f))
		{
			image = s_image.Sample(smp_rtlinear, I.tc0).rgb;
			float center_depth = image.b;

			float scale = 0.3f;
			scale *= IGN_calc(I.tc0 / 2.0 * screen_res.xy);

			float3 total = 0.0f;
			float divisor = 0.0f;

			float r = 1.0f;
			float2x2 G = rot(2.399996);
			float2 offset = float2(scale, scale);

			for (int i = 0; i < 24; ++i)
			{
				r += 1.0f / r;
				offset = mul(offset, G);

				// Depth-based falloff: peaks at mid-near, falls off at distance
				float falloff = saturate(
					(1.2f * center_depth) - log(center_depth * 6.4f) - (0.4f * pow(center_depth, 2.3f)));

				float2 sample_uv = I.tc0 + aspect_correct_offset(
					offset * falloff * (r - 1.02f) / screen_res.xy);

				float3 color = s_image.SampleLevel(smp_rtlinear, sample_uv, 0).rgb;
				float weight = 1.0f;
				total += color * weight;
				divisor += weight;
			}

			image = max(total / divisor, 0);
			float vignette = calc_vignette(lua_param_nvg_num_tubes, I.tc0, lua_param_vignette_current);
			image = clamp(image, 0.0, 1.0) * vignette;
			return float4(image, 1.0f);
		}

		// =====================================================================
		// QUARTER RES BLUR - PASS 1
		// =====================================================================
		else if (blur_params.x == 1 && blur_params.z == (screen_res.x / 4))
		{
			image = circular_blur_thresh(I.tc0,
				0.05,                          // general_threshold
				lua_param_nvg_washout_thresh,  // light_threshold
				12.0, 6.0, 1.5);              // directions, quality, radius
			return float4(image, 1.0);
		}

		// =====================================================================
		// QUARTER RES BLUR - PASS 2
		// =====================================================================
		else if (blur_params.x == 0 && blur_params.z == (screen_res.x / 4))
		{
			image = circular_blur_smooth(I.tc0, 16.0, 4.0, 4.0);
			return float4(image, 1.0);
		}

		// =====================================================================
		// EIGHTH RES BLUR - PASS 1
		// =====================================================================
		else if (blur_params.x == 1 && blur_params.z == (screen_res.x / 8))
		{
			image = circular_blur_thresh(I.tc0,
				0.05,                          // general_threshold
				lua_param_nvg_washout_thresh,  // light_threshold
				12.0, 4.0, 1.0);              // directions, quality, radius
			return float4(image, 1.0);
		}

		// =====================================================================
		// EIGHTH RES BLUR - PASS 2
		// =====================================================================
		else if (blur_params.x == 0 && blur_params.z == (screen_res.x / 8))
		{
			image = circular_blur_smooth(I.tc0, 16.0, 4.0, 4.0);
			return float4(image, 1.0);
		}
	}

	// =========================================================================
	// FALLBACK: SSS blur (non-NVG path)
	// =========================================================================
	return SSFX_Blur(I.tc0, 0.25f);
}
