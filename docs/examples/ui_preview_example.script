-- Developer-invoked example; no callbacks and no spawned inventory items.
local window
local model_name='ui_preview_example_model'
class 'Example' (CUIScriptWnd)
function Example:__init() super()
    self:SetAutoDelete(false)
    local xml=CScriptXmlInit();xml:ParseFile('ui_preview_example.xml')
    xml:InitWindow('window',0,self);xml:InitTextWnd('title',self)
    self.context=CUIPreviewContext()
    self.context:set_background_color(GetARGB(255,30,32,35))
    self.context:set_dry(true)
end
function Example:Update()
    CUIScriptWnd.Update(self)
    if self:IsShown() and not self.context:request_scene_suppression() then self:Close() end
end
function Example:Close()
    self.context:release()
    if db.actor then db.actor:remove_attachment(model_name) end
    self:HideDialog()
end
function Example:OnKeyboard(key,action)
    if key==DIK_keys.DIK_ESCAPE then self:Close();return true end
    return CUIScriptWnd.OnKeyboard(self,key,action)
end
function show(section)
    if not ui_preview or not ui_preview.supports('scene_suppression') or not db.actor then return false end
    local ini=system_ini();section=section or 'wpn_ak74'
    if not ini:section_exist(section) or not ini:line_exist(section,'visual') then return false end
    if not window then window=Example() end
    if window:IsShown() then window:Close() end
    if not window.context:request_scene_suppression() then return false end
    local model=db.actor:add_attachment(model_name,ini:r_string(section,'visual'))
    if not model then window.context:release();return false end
    model:set_type(script_attachment_type.CamAttached)
    model:set_position(0,0,1.2);model:set_rotation(0,90,0)
    window:ShowDialog(true);return true
end
function close() if window then window:Close() end end
