include_guard()

# Normalize existing compiler flags
if(MSVC)
	string(REPLACE "/INCREMENTAL" "/INCREMENTAL:NO" CMAKE_EXE_LINKER_FLAGS_RELWITHDEBINFO "${CMAKE_EXE_LINKER_FLAGS_RELWITHDEBINFO}")
	string(APPEND CMAKE_STATIC_LINKER_FLAGS_PROFILED " /LTCG")
	string(APPEND CMAKE_STATIC_LINKER_FLAGS_RELEASE " /LTCG")
	string(APPEND CMAKE_STATIC_LINKER_FLAGS_RELWITHDEBINFO " /LTCG")
	string(APPEND CMAKE_SHARED_LINKER_FLAGS_PROFILED " /LTCG")
	string(APPEND CMAKE_SHARED_LINKER_FLAGS_RELEASE " /LTCG")
	string(APPEND CMAKE_SHARED_LINKER_FLAGS_RELWITHDEBINFO " /LTCG")
endif()

# Append X-Ray linker flags
string(JOIN " " CMAKE_EXE_LINKER_FLAGS ${CMAKE_EXE_LINKER_FLAGS} ${XRAY_LINKER_FLAGS})
string(JOIN " " CMAKE_EXE_LINKER_FLAGS_DEBUG ${CMAKE_EXE_LINKER_FLAGS_DEBUG} ${XRAY_LINKER_FLAGS_DEBUG})
string(JOIN " " CMAKE_EXE_LINKER_FLAGS_RELEASE ${CMAKE_EXE_LINKER_FLAGS_RELEASE} ${XRAY_LINKER_FLAGS_RELEASE})
string(JOIN " " CMAKE_EXE_LINKER_FLAGS_RELWITHDEBINFO ${CMAKE_EXE_LINKER_FLAGS_RELWITHDEBINFO} ${XRAY_LINKER_FLAGS_RELEASE})

# Setup Verified configuration
set(CMAKE_EXE_LINKER_FLAGS_VERIFIED "${CMAKE_EXE_LINKER_FLAGS_DEBUG}")

# Setup Profiled configuration
set(CMAKE_EXE_LINKER_FLAGS_PROFILED "${CMAKE_EXE_LINKER_FLAGS_RELEASE}")
string(REPLACE "/INCREMENTAL:NO" "/INCREMENTAL" CMAKE_EXE_LINKER_FLAGS_PROFILED "${CMAKE_EXE_LINKER_FLAGS_PROFILED}")
string(REPLACE "/LTCG" "" CMAKE_EXE_LINKER_FLAGS_PROFILED "${CMAKE_EXE_LINKER_FLAGS_PROFILED}")

# Print linker options
message(DEBUG)
message(DEBUG "Linker Flags:")
message(DEBUG "        Global: ${CMAKE_EXE_LINKER_FLAGS}")
message(DEBUG "         Debug: ${CMAKE_EXE_LINKER_FLAGS_DEBUG}")
message(DEBUG "      Verified: ${CMAKE_EXE_LINKER_FLAGS_VERIFIED}")
message(DEBUG "      Profiled: ${CMAKE_EXE_LINKER_FLAGS_PROFILED}")
message(DEBUG "       Release: ${CMAKE_EXE_LINKER_FLAGS_RELEASE}")
message(DEBUG "RelWithDebInfo: ${CMAKE_EXE_LINKER_FLAGS_RELWITHDEBINFO}")